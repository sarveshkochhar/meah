# MEAH environment configuration — copy to .env (gitignored) or export these
# in the environment that launches the MCP server.
#
# NEVER commit real keys. If a key is ever pasted into a chat or a tracked file,
# rotate it immediately.

# ---------------------------------------------------------------------------
# Provider 1: Z.AI GLM (OpenAI-compatible)
# ---------------------------------------------------------------------------
MEAH_PROVIDER_GLM_BASE_URL=https://api.z.ai/api/paas/v4
MEAH_PROVIDER_GLM_API_KEY_ENV=MEAH_GLM_API_KEY
MEAH_PROVIDER_GLM_MODEL=glm-4.5-air
# Optional catalog. If set, MEAH rejects models outside it for THIS provider.
MEAH_PROVIDER_GLM_MODELS=glm-4.5-air,glm-4.6
MEAH_GLM_API_KEY=

# ---------------------------------------------------------------------------
# Provider 2: aicredits (OpenAI-compatible) — independent endpoint, key, model.
# Its model catalog is NOT the same as Z.AI's; set the model names your account
# actually has access to.
# ---------------------------------------------------------------------------
MEAH_PROVIDER_AICREDITS_BASE_URL=https://aicredits.in/v1
MEAH_PROVIDER_AICREDITS_API_KEY_ENV=MEAH_AICREDITS_API_KEY
# Verified live 2026-09-04: this gateway exposes 406 active chat models with
# OpenRouter-style ids, including the full z-ai/glm-* family.
MEAH_PROVIDER_AICREDITS_MODEL=z-ai/glm-4.6
# MEAH_PROVIDER_AICREDITS_MODELS=z-ai/glm-4.6,z-ai/glm-4.7,openai/gpt-4o-mini
MEAH_AICREDITS_API_KEY=

# ---------------------------------------------------------------------------
# Role routing (optional). Unset roles fall back to the sole configured
# provider; with several providers, an unrouted role must name one explicitly.
# ---------------------------------------------------------------------------
# Pattern: MEAH_ROLE_<ROLE>_PROVIDER and MEAH_ROLE_<ROLE>_MODEL.
# Point a role at whichever model suits it; they are independent.
MEAH_ROLE_RESEARCHER_PROVIDER=aicredits
MEAH_ROLE_RESEARCHER_MODEL=z-ai/glm-4.6

# builder writes new components from scratch: give it your strongest model.
MEAH_ROLE_BUILDER_PROVIDER=aicredits
MEAH_ROLE_BUILDER_MODEL=z-ai/glm-4.7

# coder makes focused edits to existing code.
MEAH_ROLE_CODER_PROVIDER=aicredits
MEAH_ROLE_CODER_MODEL=z-ai/glm-4.7

# debugger reasons from a symptom to a root cause: reasoning models earn their
# keep here, so give it plenty of output budget (maxOutputTokens 2000+).
MEAH_ROLE_DEBUGGER_PROVIDER=aicredits
MEAH_ROLE_DEBUGGER_MODEL=z-ai/glm-4.7

MEAH_ROLE_REVIEWER_PROVIDER=aicredits
MEAH_ROLE_REVIEWER_MODEL=z-ai/glm-4.6

# A fast non-reasoning model is a better summarizer, and much cheaper.
MEAH_ROLE_SUMMARIZER_PROVIDER=aicredits
MEAH_ROLE_SUMMARIZER_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Runtime limits (optional; these are the defaults)
# ---------------------------------------------------------------------------
MEAH_TIMEOUT_MS=120000
MEAH_MAX_CONCURRENT=3
MEAH_MAX_CONTEXT_CHARS=60000
MEAH_WORKSPACE_ROOT=workspaces
MEAH_LOG_LEVEL=info

# Retain full prompts in memory for meah_get_agent(includeTranscript). Off by default.
MEAH_RETAIN_TRANSCRIPTS=false

# Terminal execution for the "workspace-exec" permission profile. Off by default.
MEAH_TERMINAL_ENABLED=false

# Built-in deterministic mock provider (no network, no key). For demos/smoke tests.
MEAH_ENABLE_MOCK_PROVIDER=false

# Path to a local JSON config file (default: ./meah.config.json, gitignored).
# MEAH_CONFIG=meah.config.json
